<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head") %>

  <body class="min-h-screen flex flex-col bg-gray-100">
    <%- include("../partials/nav") %>

    <main class="flex flex-1 items-center justify-center px-2">
      <div
        class="w-full max-w-md bg-linear-to-br from-white to-indigo-50 rounded-2xl shadow-xl p-8 border border-indigo-100 hover:shadow-2xl transition"
      >
        <!-- Title -->
        <div class="flex flex-col items-center mb-4">
          <div
            class="bg-linear-to-br from-indigo-100 to-indigo-200 rounded-full p-3 mb-3"
          >
            <!-- logo / house icon -->
            <svg
              class="w-10 h-10 text-indigo-700"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 12l9-9 9 9M9 21V9h6v12"
              />
            </svg>
          </div>
          <h1
            class="text-2xl font-bold text-center text-indigo-700 mb-1 tracking-tight"
          >
            Welcome to Airbnb
          </h1>
          <p class="text-sm text-center text-indigo-500 mb-4">
            Please register first
          </p>
        </div>

        <!-- Register Form -->
        <form
          id="registerForm"
          action="/register"
          method="post"
          class="space-y-4"
          novalidate
        >
          <!-- server-side error (if provided) -->
          <%- include("../partials/errors") %>
          <!-- Name row: First + Last -->
          <div class="sm:flex sm:space-x-3">
            <div class="sm:w-1/2">
              <label class="block text-sm font-medium text-gray-700 mb-1">
                First Name
              </label>
              <div class="relative">
                <span
                  class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"
                >
                  <svg
                    class="w-5 h-5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                    />
                  </svg>
                </span>
                <input
                  type="text"
                  name="firstName"
                  value="<%= (oldInput && oldInput.firstName) ? oldInput.firstName : '' %>"
                  required
                  autocomplete="given-name"
                  class="w-full pl-10 px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                  placeholder="John"
                />
              </div>
            </div>

            <div class="sm:w-1/2 mt-4 sm:mt-0">
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Last Name
              </label>
              <div class="relative">
                <span
                  class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"
                >
                  <svg
                    class="w-5 h-5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                    />
                  </svg>
                </span>
                <input
                  type="text"
                  name="lastName"
                  value="<%= (oldInput && oldInput.lastName) ? oldInput.lastName : '' %>"
                  required
                  autocomplete="family-name"
                  class="w-full pl-10 px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                  placeholder="Doe"
                />
              </div>
            </div>
          </div>

          <!-- Phone -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Phone Number
            </label>
            <div class="relative">
              <span
                class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"
              >
                <svg
                  class="w-5 h-5"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                  />
                </svg>
              </span>
              <input
                type="tel"
                name="phone"
                value="<%= (oldInput && oldInput.phone) ? oldInput.phone : '' %>"
                required
                autocomplete="tel"
                class="w-full pl-10 px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                placeholder="+1 555 555 5555"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Email
            </label>
            <div class="relative">
              <span
                class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"
              >
                <svg
                  class="w-5 h-5"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  />
                </svg>
              </span>
              <input
                type="email"
                name="email"
                value="<%= (oldInput && oldInput.email) ? oldInput.email : '' %>"
                required
                autocomplete="email"
                class="w-full pl-10 px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                placeholder="you@example.com"
                aria-describedby="emailError"
              />
              <p id="emailError" class="text-sm text-red-600 mt-1 hidden">
                Please enter a valid email address.
              </p>
            </div>
          </div>

          <!-- Password -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Password
            </label>
            <div class="relative">
              <input
                id="password"
                type="password"
                name="password"
                autocomplete="new-password"
                required
                minlength="8"
                aria-describedby="passwordError passwordHelp"
                class="w-full px-3 py-2 pr-10 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                placeholder="Minimum 8 characters"
              />
              <button
                type="button"
                onclick="toggle('password')"
                class="absolute inset-y-0 right-2 flex items-center px-2 text-gray-500"
                aria-label="Toggle password visibility"
              >
                <svg
                  id="eye1"
                  class="w-5 h-5"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
              </button>
              <p id="passwordHelp" class="text-sm text-gray-500 mt-1">
                Use at least 8 characters.
              </p>
              <p id="passwordError" class="text-sm text-red-600 mt-1 hidden">
                Password must be at least 8 characters.
              </p>
            </div>
          </div>

          <!-- Confirm Password -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Confirm Password
            </label>
            <div class="relative">
              <input
                id="confirmPassword"
                type="password"
                name="confirmPassword"
                autocomplete="new-password"
                required
                aria-describedby="confirmPasswordError"
                class="w-full px-3 py-2 pr-10 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                placeholder="Repeat your password"
              />
              <button
                type="button"
                onclick="toggle('confirmPassword')"
                class="absolute inset-y-0 right-2 flex items-center px-2 text-gray-500"
                aria-label="Toggle password visibility"
              >
                <svg
                  id="eye2"
                  class="w-5 h-5"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
              </button>
              <p
                id="confirmPasswordError"
                class="text-sm text-red-600 mt-1 hidden"
              >
                Passwords do not match.
              </p>
            </div>
          </div>
          <!-- Role -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Role
            </label>
            <div class="relative">
              <span
                class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"
              >
                <svg
                  class="w-4 h-4 text-indigo-500"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M12 14l9-5-9-5-9 5 9 5z"
                  />
                </svg>
              </span>
              <select
                name="role"
                required
                class="w-full pl-10 px-3 py-2 border border-gray-200 bg-white rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300 hover:border-indigo-300"
              >
                <option value="" disabled <%= !(oldInput && oldInput.role) ? 'selected' : '' %>>Select role</option>
                <option value="user" <%= (oldInput && oldInput.role === 'user') ? 'selected' : '' %>>User</option>
                <option value="admin" <%= (oldInput && oldInput.role === 'admin') ? 'selected' : '' %>>Admin</option>
              </select>
            </div>
          </div>
          <div>
            <label class="inline-flex items-center space-x-2">
              <input
                id="termsAccepted"
                type="checkbox"
                name="termsAccepted"
                class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500"
              />
              <span class="text-sm text-gray-700"
                >I accept the
                <a href="/terms" class="text-indigo-700 underline"
                  >terms and conditions</a
                ></span
              >
            </label>
            <p id="termsError" class="text-sm text-red-600 mt-1 hidden">
              You must accept the terms and conditions.
            </p>
          </div>
          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-linear-to-r from-indigo-600 to-indigo-500 text-white py-2 rounded-lg font-semibold hover:from-indigo-700 hover:to-indigo-600 transition shadow-md"
          >
            Register
          </button>
        </form>

        <!-- Footer -->
        <p class="text-sm text-center text-gray-600 mt-4">
          Already have an account?
          <a href="/login" class="text-indigo-700 font-medium hover:underline">
            Login here
          </a>
        </p>
      </div>
    </main>

    <script>
      (function () {
        const form = document.getElementById("registerForm");
        const password = document.getElementById("password");
        const confirmPassword = document.getElementById("confirmPassword");
        const terms = document.getElementById("termsAccepted");

        function show(el) {
          el.classList.remove("hidden");
        }
        function hide(el) {
          el.classList.add("hidden");
        }

        function validatePassword() {
          const passErr = document.getElementById("passwordError");
          if (password.value.length < 8) {
            show(passErr);
            return false;
          }
          hide(passErr);
          return true;
        }

        function validateConfirm() {
          const confirmErr = document.getElementById("confirmPasswordError");
          if (confirmPassword.value !== password.value) {
            show(confirmErr);
            return false;
          }
          hide(confirmErr);
          return true;
        }

        function validateTerms() {
          const termsErr = document.getElementById("termsError");
          if (!terms.checked) {
            show(termsErr);
            return false;
          }
          hide(termsErr);
          return true;
        }

        // toggle password visibility
        window.toggle = function (id) {
          const input = document.getElementById(id);
          input.type = input.type === "password" ? "text" : "password";
        };

        // real-time checks
        password.addEventListener("input", function () {
          validatePassword();
          if (confirmPassword.value) validateConfirm();
        });
        confirmPassword.addEventListener("input", validateConfirm);

        form.addEventListener("submit", function (e) {
          let ok = true;
          if (!validatePassword()) ok = false;
          if (!validateConfirm()) ok = false;
          if (!validateTerms()) ok = false;

          if (!ok) {
            e.preventDefault();
            // focus first error
            if (
              document
                .getElementById("passwordError")
                .classList.contains("hidden") === false
            )
              password.focus();
            else if (
              document
                .getElementById("confirmPasswordError")
                .classList.contains("hidden") === false
            )
              confirmPassword.focus();
            else if (
              document
                .getElementById("termsError")
                .classList.contains("hidden") === false
            )
              terms.focus();
          }
        });
      })();
    </script>
  </body>
</html>
