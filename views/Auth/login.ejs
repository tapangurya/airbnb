<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body class="min-h-screen flex flex-col bg-gray-100">
    <%- include("../partials/nav") %>

    <main class="flex flex-1 items-center justify-center px-4">
      <div
        class="w-full max-w-md bg-linear-to-br from-white to-indigo-50 rounded-2xl shadow-xl p-8 border border-indigo-100 hover:shadow-2xl transition"
      >
        <!-- Title -->
        <div class="flex flex-col items-center mb-4">
          <div
            class="bg-linear-to-br from-indigo-100 to-indigo-200 rounded-full p-3 mb-3"
          >
            <svg
              class="w-10 h-10 text-indigo-700"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 12l9-9 9 9M9 21V9h6v12"
              />
            </svg>
          </div>
          <h1
            class="text-2xl font-bold text-center text-indigo-700 mb-1 tracking-tight"
          >
            Welcome Back
          </h1>
          <p class="text-sm text-center text-indigo-500 mb-6">
            Please login to your account
          </p>
        </div>

        <!-- Login Form -->
        <form
          id="loginForm"
          action="/login"
          method="post"
          class="space-y-5"
          novalidate
        >
          <%- include("../partials/errors") %>
          <!-- Email -->
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-indigo-700 mb-1"
            >
              Email
            </label>
            <div class="relative">
              <span
                class="absolute inset-y-0 left-0 pl-3 flex items-center text-indigo-500"
              >
                <svg
                  class="w-4 h-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 12H8m-4 0h.01M3 7h18M3 17h18M3 7l9 5 9-5"
                  />
                </svg>
              </span>
              <input
                id="email"
                type="email"
                name="email"
                autocomplete="email"
                autofocus
                placeholder="you@example.com"
                value="<%= (oldInput && oldInput.email) ? oldInput.email : '' %>"
                required
                class="w-full pl-10 px-4 py-2 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                aria-describedby="loginEmailError"
              />
            </div>
            <p
              id="loginEmailError"
              role="alert"
              aria-live="assertive"
              class="text-sm text-red-600 mt-1 hidden"
            >
              Please enter a valid email address.
            </p>
          </div>

          <!-- Password -->
          <div>
            <label
              for="password"
              class="block text-sm font-medium text-indigo-700 mb-1"
            >
              Password
            </label>

            <div class="relative">
              <span
                class="absolute inset-y-0 left-0 pl-3 flex items-center text-indigo-500"
              >
                <svg
                  class="w-4 h-4"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M12 15v2m0-8v2m-6 4h12a2 2 0 002-2V9a2 2 0 00-2-2H6a2 2 0 00-2 2v4a2 2 0 002 2z"
                  />
                </svg>
              </span>
              <input
                id="password"
                type="password"
                name="password"
                autocomplete="current-password"
                placeholder="Enter your password"
                required
                class="w-full pl-10 px-4 py-2 pr-12 border border-gray-200 bg-gray-50 rounded-lg placeholder-gray-400 transition focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-300"
                aria-describedby="loginPasswordError"
              />

              <!-- Eye Button -->
              <button
                id="togglePasswordBtn"
                type="button"
                aria-pressed="false"
                aria-label="Show password"
                onclick="togglePassword()"
                class="absolute inset-y-0 right-3 flex items-center text-gray-500 hover:text-indigo-600 focus:outline-none"
              >
                <!-- Eye Icon -->
                <svg
                  id="eyeIcon"
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  />
                </svg>
              </button>
            </div>
            <p
              id="loginPasswordError"
              class="text-sm text-red-600 mt-1 hidden"
              role="alert"
              aria-live="assertive"
            >
              Please enter your password.
            </p>
          </div>

          <!-- Button -->
          <button
            type="submit"
            class="w-full bg-linear-to-r from-indigo-600 to-indigo-500 text-white py-2 rounded-lg font-semibold hover:from-indigo-700 hover:to-indigo-600 transition shadow-md"
          >
            Login
          </button>
        </form>

        <!-- Footer -->
        <p class="text-sm text-center text-gray-600 mt-6">
          Don’t have an account?
          <a
            href="/register"
            class="text-indigo-700 font-medium hover:underline"
          >
            Sign up here
          </a>
        </p>
      </div>
    </main>
    <script>
      (function () {
        const form = document.getElementById("loginForm");
        const email = document.getElementById("email");
        const passwordInput = document.getElementById("password");
        const eyeIcon = document.getElementById("eyeIcon");
        const emailError = document.getElementById("loginEmailError");

        // toggle password visibility, update icon and accessibility attributes
        window.togglePassword = function () {
          const btn = document.getElementById("togglePasswordBtn");
          const isHidden = passwordInput.type === "password";
          if (isHidden) {
            passwordInput.type = "text";
            btn.setAttribute("aria-pressed", "true");
            btn.setAttribute("aria-label", "Hide password");
            eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 012.152-3.568M6.223 6.223A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a9.97 9.97 0 01-4.043 5.057M15 12a3 3 0 00-3-3" /> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18" />`;
          } else {
            passwordInput.type = "password";
            btn.setAttribute("aria-pressed", "false");
            btn.setAttribute("aria-label", "Show password");
            eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
          }
        };

        // simple email validation on submit
        if (form) {
          form.addEventListener("submit", function (e) {
            const validEmail =
              email && email.value && email.value.includes("@");
            if (!validEmail) {
              e.preventDefault();
              if (emailError) emailError.classList.remove("hidden");
              if (email) email.focus();
            }
          });
        }
      })();
    </script>
  </body>
</html>
