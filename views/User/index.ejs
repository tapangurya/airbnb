<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head") %>
  <body class="min-h-screen flex flex-col bg-gray-100">
    <!-- Navbar -->
    <%- include("../partials/nav") %>

    <!-- Main Content -->
    <main class="p-6">
      <h1 class="text-indigo-700 text-3xl font-bold text-center mb-6">
        Find your perfect stay
      </h1>

      <!-- Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (registeredHomes.length === 0) { %>
        <div
          class="col-span-full py-12 flex flex-col items-center text-center text-gray-600"
        >
          <svg
            class="w-16 h-16 mb-4 text-indigo-200"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 7h18M7 7v10a2 2 0 002 2h6a2 2 0 002-2V7"
            />
          </svg>
          <p class="text-lg font-medium">No homes registered yet.</p>
          <p class="text-sm mt-2">
            New homes will appear here once they are added.
          </p>
        </div>
        <% } %> <% registeredHomes.forEach(home => { %>
        <div
          class="bg-white rounded-xl overflow-hidden group transform transition duration-300 hover:shadow-2xl hover:-translate-y-1 hover:scale-102 js-card opacity-0 translate-y-4"
        >
          <a
            href="/home/<%= home._id %>"
            aria-label="View <%= home.houseName %>"
            class="block relative"
          >
            <img
              src="<%= home.imageUrl %>"
              alt="<%= home.houseName %>"
              class="w-full h-48 sm:h-56 md:h-64 lg:h-52 object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            ></div>
            <div
              class="absolute top-2 left-2 bg-indigo-700 text-white text-xs font-semibold px-3 py-1 rounded shadow"
            >
              ₹ <%= home.price %>
            </div>
            <div class="absolute top-2 right-2">
              <%- include('../partials/favoriteButton', {home}) %>
            </div>
            <div class="absolute bottom-2 left-2 text-white">
              <h3 class="text-sm font-semibold leading-tight">
                <%= home.houseName %>
              </h3>
              <p class="text-xs opacity-90 flex items-center gap-1">
                <svg
                  class="w-3 h-3 inline-block text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M17.657 16.657L13 21l-4.657-4.343A8 8 0 1117.657 16.657z"
                  />
                </svg>
                <span class="truncate max-w-48 inline-block"
                  ><%= home.location %></span
                >
              </p>
            </div>
          </a>
          <div class="p-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-0.5">
                  <% for (let i = 1; i <= 5; i++) { %> <% if (i <= home.rating)
                  { %>
                  <svg
                    class="w-4 h-4 text-yellow-400 fill-current transform transition-transform duration-200 group-hover:scale-110"
                    viewBox="0 0 20 20"
                  >
                    <path
                      d="M10 15l-5.878 3.09L5.82 11.545.941 7.41l6.09-.885L10 1l2.969 5.525 6.09.885-4.879 4.136 1.699 6.545z"
                    />
                  </svg>
                  <% } else { %>
                  <svg
                    class="w-4 h-4 text-gray-300 fill-current"
                    viewBox="0 0 20 20"
                  >
                    <path
                      d="M10 15l-5.878 3.09L5.82 11.545.941 7.41l6.09-.885L10 1l2.969 5.525 6.09.885-4.879 4.136 1.699 6.545z"
                    />
                  </svg>
                  <% } %> <% } %>
                </div>
                <span class="text-sm text-gray-500"><%= home.rating %>/5</span>
              </div>
              <a
                href="/reserve-home/<%= home._id %>"
                aria-label="Book <%= home.houseName %>"
                class="inline-block px-3 py-1 text-sm bg-linear-to-r from-indigo-600 to-indigo-500 text-white rounded hover:from-indigo-700 hover:to-indigo-600 transition shadow-sm"
                >Book Now</a
              >
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </main>
    <%- include('../partials/footer') %>
    <script>
      // staggered card entrance
      document.addEventListener("DOMContentLoaded", function () {
        const cards = document.querySelectorAll(".js-card");
        cards.forEach((card, i) => {
          setTimeout(() => {
            card.classList.remove("opacity-0", "translate-y-4");
            card.classList.add("opacity-100", "translate-y-0");
          }, i * 80);
        });
      });
    </script>
  </body>
</html>
