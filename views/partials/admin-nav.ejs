<nav
  class="bg-[#1e1e2d] border-b border-gray-800 sticky top-0 z-50 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <a
        href="<%= isSuperAdminLoggedIn ? '/superadmin' : '/superadmin/index' %>"
        class="flex items-center gap-3 group cursor-pointer"
      >
        <div
          class="bg-indigo-600 text-white p-1.5 rounded-lg shadow-lg shadow-indigo-500/30 transition-transform duration-500 group-hover:rotate-12 group-hover:scale-110"
        >
          <i class="ri-shield-star-line text-xl"></i>
        </div>

        <h1
          class="text-xl font-bold text-white tracking-tight group-hover:text-indigo-400 transition-colors duration-300"
        >
          Super Admin
        </h1>
      </a>

      <div class="flex items-center gap-6">
        <% if( isSuperAdminLoggedIn ){%>
        <div class="hidden md:flex flex-col items-end text-sm">
          <span
            class="text-gray-500 text-xs uppercase tracking-wider font-semibold"
            >Logged in as</span
          >
          <strong class="text-white"
            ><%= user?.firstName || "Super Admin" %></strong
          >
        </div>

        <form action="/superadmin/logout" method="POST">
          <button
            class="bg-red-600/90 hover:bg-red-600 text-white px-4 py-1.5 rounded-md text-sm font-medium transition-all duration-300 shadow-lg shadow-red-900/20 hover:shadow-red-600/40 hover:-translate-y-0.5 flex items-center gap-2 group"
          >
            <span>Logout</span>
            <i
              class="ri-logout-box-r-line transition-transform duration-300 group-hover:translate-x-1"
            ></i>
          </button>
        </form>
        <%} else { %>
        <a href="/login">Login</a>
        <a href="/signup">Signup</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
