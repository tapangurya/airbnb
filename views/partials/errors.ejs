<div id="error-container">
  <% if (typeof errors !== 'undefined' && errors && errors.length>0) { %>
  <div
    role="alert"
    aria-live="assertive"
    class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded text-sm mb-4"
  >
    <ul class="list-group-item-warning">
      <% errors.forEach((err)=>{ %>
      <li><%= err %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>
</div>

<script>
  setTimeout(() => {
    const errorContainer = document.getElementById("error-container");
    if (errorContainer) {
      errorContainer.style.display = "none";
    }
  }, 5000);
</script>
