<% const isFav = favourites.includes(home._id.toString()) %>

<form action="/favorite" method="post" class="inline-block">
  <input type="hidden" name="id" value="<%= home._id %>" />

  <button
    type="submit"
    title="<%= isFav ? 'Remove from favourites' : 'Add to favourites' %>"
    aria-pressed="<%= isFav ? 'true' : 'false' %>"
    class="p-2 rounded-full transition transform hover:scale-110 active:scale-95 focus:outline-none focus:ring-2 focus:ring-red-300 <%= isFav ? 'bg-red-100 border border-red-300' : 'border border-gray-200 hover:bg-red-50' %>"
  >
    <svg
      class="w-5 h-5 transition-colors duration-200 <%= isFav ? 'text-red-500' : 'text-gray-400' %>"
      viewBox="0 0 24 24"
      fill="<%= isFav ? 'currentColor' : 'none' %>"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3 9.24 3 10.91 3.81 12 5.08 13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5 22 12.28 18.6 15.36 13.45 20.04L12 21.35z"
      />
    </svg>
  </button>
</form>
