<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head") %>

  <body class="bg-gray-100 min-h-screen flex flex-col">
    <!-- Navbar -->
    <%- include("../partials/nav") %>

    <!-- Center Wrapper -->
    <div class="flex flex-1 items-center justify-center">
      <main class="w-full max-w-md bg-white rounded-xl shadow-lg p-6">
        <header class="mb-6 text-center">
          <h1 class="text-2xl font-bold text-gray-800">Edit Your Home</h1>
          <p class="text-sm text-gray-500">
            Add your property details properly
          </p>
        </header>
        <form
          action="/admin/edit-home"
          method="post"
          enctype="multipart/form-data"
          class="space-y-4"
        >
          <!-- House Name -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Current House Name
            </label>
            <input type="hidden" name="id" value="<%= home._id %>" />
            <input
              type="text"
              name="houseName"
              value="<%= home.houseName %>"
              required
              class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>

          <!-- Image URL -->
          <% if (home.imageUrl) { %>
          <div class="mb-3">
            <p class="text-sm text-gray-600 mb-1">Current image:</p>
            <img
              src="/<%= home.imageUrl %>"
              alt="Home image"
              class="w-40 h-28 object-cover rounded-lg border"
            />
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Image
            </label>
            <input
              type="file"
              name="imageUrl"
              accept="image/jpeg,image/jpg,image/png"
              class="w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-gray-500 file:text-white hover:file:bg-gray-600 border rounded-lg"
            />
          </div>
          <% } %>

          <!-- Price -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Price (per night)
            </label>
            <input
              type="number"
              name="price"
              value="<%= home.price %>"
              min="0"
              required
              class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
          <!-- rating -->

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Rating
            </label>
            <input
              type="number"
              name="rating"
              placeholder="Enter rating"
              min="0"
              max="5"
              step="0.1"
              value="<%= home.rating %>"
              required
              class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>

          <!-- Location -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Location
            </label>
            <input
              type="text"
              name="location"
              value="<%= home.location %>"
              required
              class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Home descriptions
            </label>
            <textarea
              type="text"
              name="description"
              required
              class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"
            >
<%=home.description%></textarea
            >
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-amber-500 text-white font-semibold py-2 rounded-lg hover:bg-amber-600 transition duration-200"
          >
            Edit Home
          </button>
        </form>
      </main>
    </div>
    <%- include('../partials/footer') %>
    <script>
      // staggered card entrance
      document.addEventListener("DOMContentLoaded", function () {
        const cards = document.querySelectorAll(".js-card");
        cards.forEach((card, i) => {
          setTimeout(() => {
            card.classList.remove("opacity-0", "translate-y-4");
            card.classList.add("opacity-100", "translate-y-0");
          }, i * 80);
        });
      });
    </script>
  </body>
</html>
