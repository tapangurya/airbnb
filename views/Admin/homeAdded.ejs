<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head") %>

  <body class="bg-gray-100 min-h-screen flex flex-col">
    <!-- Navbar -->
    <%- include("../partials/nav") %>

    <!-- Center Wrapper -->
    <div class="flex flex-1 items-center justify-center">
      <main
        class="w-full max-w-md bg-white rounded-xl shadow-lg p-6 flex flex-col items-center justify-center"
      >
        <header>
          <h1 class="text-2xl font-bold text-green-600 mb-4">
            Home Registered Successfully
          </h1>
        </header>
        <p class="text-gray-600 mb-6">
          Your home has been added and is now visible to guests.
        </p>

        <a
          href="/Admin/home-list"
          class="inline-block bg-gray-900 text-white px-6 py-2 rounded-lg font-semibold hover:bg-gray-700 transition"
        >
          Go to Home
        </a>
      </main>
    </div>
    <%- include('../partials/footer') %>
    <script>
      // staggered card entrance
      document.addEventListener("DOMContentLoaded", function () {
        const cards = document.querySelectorAll(".js-card");
        cards.forEach((card, i) => {
          setTimeout(() => {
            card.classList.remove("opacity-0", "translate-y-4");
            card.classList.add("opacity-100", "translate-y-0");
          }, i * 80);
        });
      });
    </script>
  </body>
</html>
