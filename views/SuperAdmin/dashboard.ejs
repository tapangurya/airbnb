<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Inter", sans-serif;
      }
      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0f111a;
      }
      ::-webkit-scrollbar-thumb {
        background: #33334d;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #4b4b6a;
      }

      /* Entrance Animation Keyframes */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-enter {
        animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      /* Staggered animation delays for grid items */
      .delay-100 {
        animation-delay: 100ms;
      }
      .delay-200 {
        animation-delay: 200ms;
      }
      .delay-300 {
        animation-delay: 300ms;
      }
    </style>
  </head>

  <body
    class="bg-[#0f111a] text-gray-300 min-h-screen flex flex-col antialiased"
  >
    <%- include("../partials/admin-nav") %>

    <div
      class="flex-grow p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full animate-enter"
    >
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-white">Overview</h2>
        <p class="text-gray-400 text-sm mt-1">
          Here is an overview of system metrics and recent activity.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div
          class="bg-[#1e1e2d] p-6 rounded-xl border border-gray-800 relative overflow-hidden group transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-500/20 hover:border-emerald-500/50 delay-100 animate-enter opacity-0"
        >
          <div class="relative z-10">
            <p
              class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 group-hover:text-emerald-400 transition-colors"
            >
              Total Users
            </p>
            <h3 class="text-4xl font-bold text-emerald-400">
              <%= totalUsers %>
            </h3>
            <p
              class="text-gray-600 text-xs mt-2 group-hover:text-gray-400 transition-colors"
            >
              Active Accounts
            </p>
          </div>
          <div
            class="absolute right-0 top-0 p-4 opacity-10 text-emerald-500 transition-all duration-500 ease-out group-hover:scale-125 group-hover:rotate-12 group-hover:opacity-20"
          >
            <i class="ri-user-line text-6xl"></i>
          </div>
        </div>

        <div
          class="bg-[#1e1e2d] p-6 rounded-xl border border-gray-800 relative overflow-hidden group transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-2xl hover:shadow-rose-500/20 hover:border-rose-500/50 delay-200 animate-enter opacity-0"
        >
          <div class="relative z-10">
            <p
              class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 group-hover:text-rose-400 transition-colors"
            >
              Total Admins
            </p>
            <h3 class="text-4xl font-bold text-rose-500"><%= totalAdmins %></h3>
            <p
              class="text-gray-600 text-xs mt-2 group-hover:text-gray-400 transition-colors"
            >
              Privileged Access
            </p>
          </div>
          <div
            class="absolute right-0 top-0 p-4 opacity-10 text-rose-500 transition-all duration-500 ease-out group-hover:scale-125 group-hover:-rotate-12 group-hover:opacity-20"
          >
            <i class="ri-shield-user-line text-6xl"></i>
          </div>
        </div>

        <div
          class="bg-[#1e1e2d] p-6 rounded-xl border border-gray-800 relative overflow-hidden group transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-2xl hover:shadow-blue-500/20 hover:border-blue-500/50 delay-300 animate-enter opacity-0"
        >
          <div class="relative z-10">
            <p
              class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 group-hover:text-blue-400 transition-colors"
            >
              Total Homes
            </p>
            <h3 class="text-4xl font-bold text-blue-500"><%= totalHomes %></h3>
            <p
              class="text-gray-600 text-xs mt-2 group-hover:text-gray-400 transition-colors"
            >
              Registered Properties
            </p>
          </div>
          <div
            class="absolute right-0 top-0 p-4 opacity-10 text-blue-500 transition-all duration-500 ease-out group-hover:scale-125 group-hover:translate-x-2 group-hover:opacity-20"
          >
            <i class="ri-home-4-line text-6xl"></i>
          </div>
        </div>

        <div
          class="bg-[#1e1e2d] p-6 rounded-xl border border-gray-800 relative overflow-hidden group transition-all duration-300 ease-out hover:-translate-y-2 hover:shadow-2xl hover:shadow-indigo-500/20 hover:border-indigo-500/50 delay-300 animate-enter opacity-0"
        >
          <div class="relative z-10">
            <p
              class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 group-hover:text-indigo-400 transition-colors"
            >
              Total Bookings
            </p>
            <h3 class="text-4xl font-bold text-indigo-400">
              <%= totalBookings %>
            </h3>
            <p
              class="text-gray-600 text-xs mt-2 group-hover:text-gray-400 transition-colors"
            >
              Successful Orders
            </p>
          </div>
          <div
            class="absolute right-0 top-0 p-4 opacity-10 text-indigo-500 transition-all duration-500 ease-out group-hover:scale-125 group-hover:rotate-6 group-hover:opacity-20"
          >
            <i class="ri-calendar-check-line text-6xl"></i>
          </div>
        </div>
      </div>

      <div class="mb-4 flex items-center gap-3">
        <div
          class="w-1 h-6 bg-indigo-500 rounded-full shadow-[0_0_10px_rgba(99,102,241,0.5)]"
        ></div>
        <h2 class="text-lg font-bold text-white">Quick Actions</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <a
          href="/superadmin/users"
          class="group bg-[#1e1e2d] p-6 rounded-xl border border-gray-800 shadow-lg transition-all duration-300 ease-out hover:bg-[#232336] hover:-translate-y-1 hover:border-blue-500/30 hover:shadow-xl hover:shadow-blue-900/10"
        >
          <div class="flex items-center gap-4 mb-3">
            <div
              class="bg-blue-500/10 text-blue-400 p-3 rounded-lg transition-all duration-300 group-hover:bg-blue-500 group-hover:text-white group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-blue-500/40"
            >
              <i class="ri-group-line text-xl"></i>
            </div>
            <h3
              class="font-bold text-white text-lg group-hover:text-blue-400 transition-colors"
            >
              Manage Users
            </h3>
          </div>
          <p
            class="text-gray-500 text-sm group-hover:text-gray-300 transition-colors"
          >
            View details, ban suspicious accounts, or manage user permissions.
          </p>
        </a>

        <a
          href="/superadmin/admins"
          class="group bg-[#1e1e2d] p-6 rounded-xl border border-gray-800 shadow-lg transition-all duration-300 ease-out hover:bg-[#232336] hover:-translate-y-1 hover:border-indigo-500/30 hover:shadow-xl hover:shadow-indigo-900/10"
        >
          <div class="flex items-center gap-4 mb-3">
            <div
              class="bg-indigo-500/10 text-indigo-400 p-3 rounded-lg transition-all duration-300 group-hover:bg-indigo-500 group-hover:text-white group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-indigo-500/40"
            >
              <i class="ri-shield-user-line text-xl"></i>
            </div>
            <h3
              class="font-bold text-white text-lg group-hover:text-indigo-400 transition-colors"
            >
              Manage Admins
            </h3>
          </div>
          <p
            class="text-gray-500 text-sm group-hover:text-gray-300 transition-colors"
          >
            Control admin access, assign territories, and oversee properties.
          </p>
        </a>

        <a
          href="/superadmin/activity-log"
          class="group bg-[#1e1e2d] p-6 rounded-xl border border-gray-800 shadow-lg transition-all duration-300 ease-out hover:bg-[#232336] hover:-translate-y-1 hover:border-purple-500/30 hover:shadow-xl hover:shadow-purple-900/10"
        >
          <div class="flex items-center gap-4 mb-3">
            <div
              class="bg-purple-500/10 text-purple-400 p-3 rounded-lg transition-all duration-300 group-hover:bg-purple-500 group-hover:text-white group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-purple-500/40"
            >
              <i class="ri-file-list-3-line text-xl"></i>
            </div>
            <h3
              class="font-bold text-white text-lg group-hover:text-purple-400 transition-colors"
            >
              Activity Logs
            </h3>
          </div>
          <p
            class="text-gray-500 text-sm group-hover:text-gray-300 transition-colors"
          >
            Monitor system health, security events, and audit trails.
          </p>
        </a>
      </div>

      <div class="mb-4 flex items-center gap-3">
        <div
          class="w-1 h-6 bg-pink-500 rounded-full shadow-[0_0_10px_rgba(236,72,153,0.5)]"
        ></div>
        <h2 class="text-lg font-bold text-white">Recent Activity Feed</h2>
      </div>

      <div
        class="bg-[#1e1e2d] rounded-xl shadow-lg border border-gray-800 overflow-hidden"
      >
        <div
          class="hidden sm:grid grid-cols-12 gap-4 px-6 py-4 bg-[#252538] border-b border-gray-700 text-xs font-semibold text-gray-400 uppercase tracking-wider"
        >
          <div class="col-span-4">Actor</div>
          <div class="col-span-5">Action Details</div>
          <div class="col-span-3 text-right">Time</div>
        </div>

        <div class="p-0">
          <% if (!recentActivities || recentActivities.length === 0) { %>
          <div
            class="p-12 text-center flex flex-col items-center justify-center"
          >
            <div class="bg-gray-800 p-4 rounded-full mb-3 animate-pulse">
              <i class="ri-inbox-archive-line text-2xl text-gray-500"></i>
            </div>
            <p class="text-gray-500 text-sm">No activity records found.</p>
          </div>
          <% } else { %>
          <ul class="divide-y divide-gray-800">
            <% recentActivities.forEach(activity => { %>
            <li
              class="px-6 py-4 transition-all duration-200 ease-in-out hover:bg-[#2a2a38] hover:pl-7 border-l-2 border-transparent hover:border-indigo-500 cursor-default group"
            >
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                <div class="col-span-4 flex items-center gap-3">
                  <div
                    class="flex-shrink-0 transition-transform duration-300 group-hover:scale-110"
                  >
                    <% if (activity.actorType === 'ADMIN') { %>
                    <div
                      class="w-8 h-8 rounded bg-indigo-500/20 text-indigo-400 flex items-center justify-center"
                    >
                      <i class="ri-shield-user-fill text-sm"></i>
                    </div>
                    <% } else if (activity.actorType === 'USER') { %>
                    <div
                      class="w-8 h-8 rounded bg-blue-500/20 text-blue-400 flex items-center justify-center"
                    >
                      <i class="ri-user-smile-fill text-sm"></i>
                    </div>
                    <% } else { %>
                    <div
                      class="w-8 h-8 rounded bg-gray-700 text-gray-400 flex items-center justify-center"
                    >
                      <i class="ri-server-fill text-sm"></i>
                    </div>
                    <% } %>
                  </div>
                  <div>
                    <p
                      class="text-sm font-medium text-white group-hover:text-indigo-200 transition-colors"
                    >
                      <%= activity.actorId ? activity.actorId.firstName + " " +
                      (activity.actorId.lastName || "") : "System" %>
                    </p>
                    <p class="text-xs text-gray-500 uppercase">
                      <%= activity.actorType %>
                    </p>
                  </div>
                </div>

                <div class="col-span-5">
                  <span
                    class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700 group-hover:border-gray-500 transition-colors"
                  >
                    <%= activity.action %>
                  </span>
                  <% if (activity.description) { %>
                  <p
                    class="text-sm text-gray-400 mt-1 truncate group-hover:text-gray-300 transition-colors"
                  >
                    <%= activity.description %>
                  </p>
                  <% } %>
                </div>

                <div
                  class="col-span-3 text-right text-xs text-gray-500 font-mono group-hover:text-gray-400 transition-colors"
                >
                  <%= new Date(activity.createdAt).toLocaleString() %>
                </div>
              </div>
            </li>
            <% }) %>
          </ul>

          <div
            class="p-4 bg-[#252538] border-t border-gray-800 text-center relative group"
          >
            <a
              href="/superadmin/activity-log"
              class="inline-block text-xs font-semibold text-indigo-400 transition-all duration-300 hover:text-indigo-300 hover:scale-105 uppercase tracking-wide"
            >
              View All Activity
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                >&rarr;</span
              >
            </a>
          </div>
          <% } %>
        </div>
      </div>

      <div class="mt-8 text-center text-xs text-gray-600">
        &copy; 2026 Management System. All rights reserved.
      </div>
    </div>
  </body>
</html>
