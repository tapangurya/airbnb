     <!DOCTYPE html>
    <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Welcome | Super Admin</title>

        <script src="https://cdn.tailwindcss.com"></script>

        <link
          href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
          rel="stylesheet"
        />

        <link
          href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
          rel="stylesheet"
        />

        <style>
          body {
            font-family: "Inter", sans-serif;
          }

          /* Entrance Animation Keyframes */
          @keyframes fadeInUp {
            from {
              opacity: 0;
              transform: translateY(30px);
            }
            to {
              opacity: 1;
              transform: translateY(0);
            }
          }

          .animate-enter {
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
          }

          /* Subtle breathing animation for the background glow */
          @keyframes breathe {
            0%,
            100% {
              opacity: 0.3;
              transform: scale(1);
            }
            50% {
              opacity: 0.5;
              transform: scale(1.1);
            }
          }

          .animate-breathe {
            animation: breathe 4s ease-in-out infinite;
          }
        </style>
      </head>

      <body
        class="bg-[#0f111a] text-gray-300 min-h-screen flex flex-col antialiased overflow-hidden"
      >
        <!-- <%- include("../partials/admin-nav") %> -->

        <main class="flex-grow flex items-center justify-center relative">
          <div
            class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-600/10 rounded-full blur-[100px] -z-10 animate-breathe"
          ></div>
          <div
            class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-600/10 rounded-full blur-[100px] -z-10 animate-breathe"
            style="animation-delay: 2s"
          ></div>

          <div class="text-center max-w-2xl px-6 animate-enter">
            <div
              class="inline-flex items-center justify-center p-6 bg-[#1e1e2d] border border-gray-800 rounded-2xl shadow-2xl shadow-black/50 mb-8 relative group hover:-translate-y-2 transition-transform duration-500"
            >
              <div
                class="absolute inset-0 bg-indigo-500/20 blur-xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-700"
              ></div>
              <i
                class="ri-command-fill text-6xl text-transparent bg-clip-text bg-gradient-to-br from-indigo-400 to-purple-500"
              ></i>
            </div>

            <h1
              class="text-5xl md:text-6xl font-bold text-white mb-6 tracking-tight"
            >
              Welcome,
              <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400"
                ><%= user?.firstName || "Admin" %></span
              >
            </h1>

            <p
              class="text-lg text-gray-400 mb-10 leading-relaxed max-w-lg mx-auto"
            >
              System operational. You have full administrative privileges to
              manage users, properties, and system logs.
            </p>

            <a
              href="/superadmin/dashboard"
              class="group relative inline-flex items-center gap-3 px-8 py-4 bg-white text-[#0f111a] font-bold rounded-xl transition-all duration-300 hover:bg-indigo-50 hover:scale-105 shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:shadow-[0_0_30px_rgba(99,102,241,0.6)]"
            >
              <span>Enter Dashboard</span>
              <i
                class="ri-arrow-right-line text-lg transition-transform duration-300 group-hover:translate-x-1"
              ></i>
            </a>

            <div class="mt-12 text-xs text-gray-600 font-mono">
              SECURE CONNECTION • ENCRYPTED
            </div>
          </div>
        </main>
      </body>
    </html>
  </body>
</html>
