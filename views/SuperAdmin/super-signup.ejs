<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Super Admin Signup</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
      }
    </style>
  </head>

  <body class="bg-slate-900 min-h-screen flex flex-col">
    <%- include("../partials/admin-nav") %>

    <div class="flex-grow flex items-center justify-center p-4">
      <div
        class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden transform transition-all duration-300"
      >
        <div
          class="bg-gradient-to-r from-indigo-600 to-blue-600 p-8 text-center"
        >
          <div
            class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/20 text-white backdrop-blur-sm shadow-lg"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
              ></path>
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-white tracking-tight">
            Create Account
          </h2>
          <p class="text-indigo-100 mt-2 text-sm">Super Admin Registration</p>
        </div>

        <div class="p-8">
          <% if (errors && errors.length > 0) { %>
          <div
            class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-r shadow-sm animate-pulse"
          >
            <div class="flex">
              <div class="ml-3">
                <% errors.forEach(err => { %>
                <p class="text-sm text-red-700 font-medium"><%= err %></p>
                <% }) %>
              </div>
            </div>
          </div>
          <% } %>

          <form
            action="/superadmin/super-signup"
            method="POST"
            class="space-y-5"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1"
                  >First Name</label
                >
                <input
                  type="text"
                  name="firstName"
                  placeholder="John"
                  value="<%= oldInput?.firstName || '' %>"
                  required
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1"
                  >Last Name</label
                >
                <input
                  type="text"
                  name="lastName"
                  placeholder="Doe"
                  value="<%= oldInput?.lastName || '' %>"
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"
                />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Email Address</label
              >
              <input
                type="email"
                name="email"
                placeholder="admin@company.com"
                value="<%= oldInput?.email || '' %>"
                required
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"
                >Password</label
              >
              <input
                type="password"
                name="password"
                placeholder="Create a strong password"
                required
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"
              />
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition-all transform hover:-translate-y-0.5"
            >
              Create Super Admin
            </button>
          </form>

          <div class="mt-8 text-center border-t border-gray-100 pt-6">
            <p class="text-sm text-gray-600">
              Already have an account?
              <a
                href="/superadmin/super-login"
                class="font-semibold text-indigo-600 hover:text-indigo-500"
                >Login here</a
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
