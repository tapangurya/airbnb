<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Admins | Super Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Inter", sans-serif;
      }
      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0f111a;
      }
      ::-webkit-scrollbar-thumb {
        background: #33334d;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #4b4b6a;
      }

      /* Animations */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .animate-enter {
        animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    </style>
  </head>

  <body
    class="bg-[#0f111a] text-gray-300 min-h-screen flex flex-col antialiased"
  >
    <%- include("../partials/admin-nav") %>

    <main
      class="flex-grow p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full animate-enter"
    >
      <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <div>
          <h1 class="text-2xl font-bold text-white flex items-center gap-2">
            Manage Admins
            <span class="text-gray-600 text-lg font-normal">/ List</span>
          </h1>
          <p class="mt-1 text-sm text-gray-400">
            A list of all administrators including their name, status, and
            management controls.
          </p>
        </div>
        <div class="mt-4 sm:mt-0">
          <span
            class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-medium bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 shadow-[0_0_10px_rgba(99,102,241,0.2)]"
          >
            <i class="ri-shield-user-line mr-2"></i>
            Total: <%= admins.length %>
          </span>
        </div>
      </div>

      <div
        class="bg-[#1e1e2d] shadow-lg shadow-black/20 rounded-xl border border-gray-800 overflow-hidden"
      >
        <% if (admins.length === 0) { %>
        <div
          class="text-center py-20 flex flex-col items-center justify-center"
        >
          <div class="bg-gray-800 p-4 rounded-full mb-4 animate-pulse">
            <i class="ri-shield-user-line text-4xl text-gray-600"></i>
          </div>
          <h3 class="text-lg font-medium text-white">No admins found</h3>
          <p class="mt-1 text-sm text-gray-500">
            Get started by creating a new admin account.
          </p>
        </div>
        <% } else { %>

        <div class="hidden md:block overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-800">
            <thead class="bg-[#252538]">
              <tr>
                <th
                  scope="col"
                  class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider"
                >
                  Admin Details
                </th>
                <th
                  scope="col"
                  class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider"
                >
                  Status
                </th>
                <th
                  scope="col"
                  class="px-6 py-4 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider"
                >
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="bg-[#1e1e2d] divide-y divide-gray-800">
              <% admins.forEach(admin => { %>
              <tr
                class="group transition-all duration-200 ease-in-out hover:bg-[#2a2a38]"
              >
                <td
                  class="px-6 py-4 whitespace-nowrap transition-all duration-200 group-hover:pl-8"
                >
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10">
                      <div
                        class="h-10 w-10 rounded-lg bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-indigo-900/20"
                      >
                        <%= admin.firstName.charAt(0) %><%= admin.lastName ?
                        admin.lastName.charAt(0) : '' %>
                      </div>
                    </div>
                    <div class="ml-4">
                      <div
                        class="text-sm font-medium text-white group-hover:text-indigo-200 transition-colors"
                      >
                        <%= admin.firstName %> <%= admin.lastName || "" %>
                      </div>
                      <div
                        class="text-sm text-gray-500 group-hover:text-gray-400"
                      >
                        <%= admin.email %>
                      </div>
                    </div>
                  </div>
                </td>

                <td class="px-6 py-4 whitespace-nowrap">
                  <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border <%= admin.isBlocked ? 'bg-red-500/10 text-red-400 border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' %>"
                  >
                    <span
                      class="w-1.5 h-1.5 mr-1.5 rounded-full <%= admin.isBlocked ? 'bg-red-500' : 'bg-emerald-500' %>"
                    ></span>
                    <%= admin.isBlocked ? 'Blocked' : 'Active' %>
                  </span>
                </td>

                <td
                  class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium"
                >
                  <div class="flex items-center justify-end gap-3">
                    <a
                      href="/superadmin/admins/<%= admin._id %>/homes"
                      class="text-gray-400 hover:text-indigo-400 p-2 rounded-lg hover:bg-indigo-500/10 transition-all duration-200 hover:scale-110"
                      title="View Homes"
                    >
                      <i class="ri-home-gear-line text-lg"></i>
                    </a>

                    <a
                      href="/superadmin/admins/<%= admin._id %>/add-home"
                      class="text-gray-400 hover:text-indigo-400 p-2 rounded-lg hover:bg-indigo-500/10 transition-all duration-200 hover:scale-110"
                      title="Add Home"
                    >
                      <i class="ri-add-box-line text-lg"></i>
                    </a>

                    <div class="h-4 w-px bg-gray-700 mx-1"></div>

                    <form
                      action="/superadmin/admins/toggle/<%= admin._id %>"
                      method="POST"
                      class="inline-block"
                    >
                      <button
                        type="submit"
                        class="p-2 rounded-lg transition-all duration-200 hover:scale-110 <%= admin.isBlocked ? 'text-emerald-500 hover:bg-emerald-500/10 hover:text-emerald-400' : 'text-red-500 hover:bg-red-500/10 hover:text-red-400' %>"
                        title="<%= admin.isBlocked ? 'Unblock User' : 'Block User' %>"
                      >
                        <i
                          class="<%= admin.isBlocked ? 'ri-lock-unlock-line' : 'ri-lock-2-line' %> text-lg"
                        ></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="md:hidden">
          <% admins.forEach(admin => { %>
          <div
            class="p-4 border-b border-gray-800 last:border-b-0 hover:bg-[#252538] transition-colors"
          >
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div
                  class="h-10 w-10 rounded-lg bg-gray-700 flex items-center justify-center text-gray-300 font-bold text-sm"
                >
                  <%= admin.firstName.charAt(0) %>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-white">
                    <%= admin.firstName %> <%= admin.lastName %>
                  </h4>
                  <p class="text-xs text-gray-500"><%= admin.email %></p>
                </div>
              </div>
              <span
                class="inline-flex items-center px-2 py-1 rounded text-xs font-medium border <%= admin.isBlocked ? 'bg-red-500/10 text-red-400 border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' %>"
              >
                <%= admin.isBlocked ? 'Blocked' : 'Active' %>
              </span>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <a
                href="/superadmin/admins/<%= admin._id %>/homes"
                class="flex items-center justify-center gap-2 px-3 py-2 text-xs font-medium text-indigo-300 bg-indigo-500/10 rounded-lg border border-indigo-500/20 hover:bg-indigo-500/20 transition-colors active:scale-95"
              >
                <i class="ri-home-gear-line"></i>
                View Homes
              </a>

              <form
                action="/superadmin/admins/toggle/<%= admin._id %>"
                method="POST"
                class="col-span-1"
              >
                <button
                  type="submit"
                  class="w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-medium text-white rounded-lg border border-transparent shadow-lg active:scale-95 transition-all duration-200 <%= admin.isBlocked ? 'bg-emerald-600 hover:bg-emerald-500 shadow-emerald-900/20' : 'bg-red-600 hover:bg-red-500 shadow-red-900/20' %>"
                >
                  <i
                    class="<%= admin.isBlocked ? 'ri-lock-unlock-line' : 'ri-lock-line' %>"
                  ></i>
                  <%= admin.isBlocked ? 'Unblock' : 'Block' %>
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>

        <% } %>
      </div>

      <div class="mt-8 text-center text-xs text-gray-600">
        &copy; 2026 Management System. All rights reserved.
      </div>
    </main>
  </body>
</html>
