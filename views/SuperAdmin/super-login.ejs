<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Super Admin Login</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Inter", sans-serif;
      }

      /* Entrance Animation */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .animate-enter {
        animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    </style>
  </head>

  <body class="bg-[#0f111a] min-h-screen flex flex-col relative text-gray-300">
    <div
      class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-indigo-600/10 rounded-full blur-[100px]"
      ></div>
      <div
        class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-purple-600/10 rounded-full blur-[100px]"
      ></div>
    </div>

    <div class="fixed top-0 left-0 w-full z-50">
      <%- include('../partials/admin-nav') %>
    </div>

    <div
      class="flex-grow flex items-center justify-center p-4 pt-24 pb-12 w-full"
    >
      <div
        class="bg-[#1e1e2d] w-full max-w-md rounded-2xl shadow-2xl shadow-black/50 border border-gray-800 overflow-hidden transform transition-all duration-300 hover:shadow-indigo-500/10 animate-enter"
      >
        <div
          class="bg-gradient-to-r from-indigo-900/50 to-blue-900/50 p-8 text-center border-b border-gray-800 relative"
        >
          <div
            class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"
          ></div>

          <div
            class="mb-4 inline-flex items-center justify-center w-14 h-14 rounded-xl bg-white/5 text-indigo-400 backdrop-blur-md border border-white/10 shadow-lg"
          >
            <i class="ri-shield-keyhole-line text-2xl"></i>
          </div>
          <h2 class="text-3xl font-bold text-white tracking-tight">
            Super Admin
          </h2>
          <p class="text-indigo-200/70 mt-2 text-sm font-medium">
            Secure Access Portal
          </p>
        </div>

        <div class="p-8">
          <% if (errors && errors.length > 0) { %>
          <div
            class="mb-6 bg-red-500/10 border-l-4 border-red-500 p-4 rounded-r animate-pulse"
          >
            <div class="flex">
              <div class="flex-shrink-0">
                <i class="ri-error-warning-fill text-red-500 text-lg"></i>
              </div>
              <div class="ml-3">
                <% errors.forEach(err => { %>
                <p class="text-sm text-red-400 font-medium"><%= err %></p>
                <% }) %>
              </div>
            </div>
          </div>
          <% } %>

          <form
            action="/superadmin/super-login"
            method="POST"
            class="space-y-6"
          >
            <div>
              <label
                class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5"
                >Email Address</label
              >
              <div class="relative group">
                <div
                  class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                >
                  <i
                    class="ri-mail-line text-gray-500 group-focus-within:text-indigo-500 transition-colors"
                  ></i>
                </div>
                <input
                  type="email"
                  name="email"
                  placeholder="admin@example.com"
                  value="<%= oldInput?.email || '' %>"
                  required
                  class="w-full pl-10 pr-4 py-3 bg-[#0f111a] border border-gray-700 rounded-lg text-gray-200 placeholder-gray-600 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all outline-none shadow-inner"
                />
              </div>
            </div>

            <div>
              <label
                class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5"
                >Password</label
              >
              <div class="relative group">
                <div
                  class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                >
                  <i
                    class="ri-lock-password-line text-gray-500 group-focus-within:text-indigo-500 transition-colors"
                  ></i>
                </div>
                <input
                  type="password"
                  name="password"
                  placeholder="••••••••"
                  required
                  class="w-full pl-10 pr-4 py-3 bg-[#0f111a] border border-gray-700 rounded-lg text-gray-200 placeholder-gray-600 focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all outline-none shadow-inner"
                />
              </div>
            </div>

            <button
              type="submit"
              class="w-full flex justify-center items-center gap-2 py-3.5 px-4 border border-transparent rounded-xl shadow-lg shadow-indigo-500/20 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#1e1e2d] focus:ring-indigo-500 transition-all duration-200 hover:-translate-y-0.5"
            >
              <span>Authenticate</span>
              <i class="ri-arrow-right-line"></i>
            </button>
          </form>

          <div class="mt-8 text-center border-t border-gray-800 pt-6">
            <p class="text-sm text-gray-500">
              Don’t have an account?
              <a
                href="/superadmin/super-signup"
                class="font-semibold text-indigo-400 hover:text-indigo-300 transition-colors ml-1"
              >
                Create Super Admin
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="pb-6 text-center text-xs text-gray-600 font-mono">
      SECURE CONNECTION • ENCRYPTED
    </div>
  </body>
</html>
