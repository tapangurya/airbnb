<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head") %>

  <body
    class="min-h-screen bg-gray-100 flex-grow flex flex-col items-center justify-center"
  >
    <main class="text-center max-w-md px-6">
      <!-- Error Code -->
      <h1 class="text-8xl font-extrabold text-amber-500 tracking-tight">404</h1>

      <!-- Message -->
      <h2 class="mt-4 text-2xl font-semibold text-gray-800">Page Not Found</h2>

      <p class="mt-2 text-gray-600">
        Sorry, the page you are looking for does not exist or has been moved.
      </p>

      <!-- Actions -->
      <div class="mt-6 flex items-center justify-center gap-4">
        <a
          href="/"
          class="px-6 py-2 rounded-lg bg-amber-500 text-white font-medium hover:bg-amber-600 transition"
        >
          Go to Home
        </a>

        <button
          onclick="history.back()"
          class="px-6 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-200 transition"
        >
          Go Back
        </button>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script>
      // staggered card entrance
      document.addEventListener("DOMContentLoaded", function () {
        const cards = document.querySelectorAll(".js-card");
        cards.forEach((card, i) => {
          setTimeout(() => {
            card.classList.remove("opacity-0", "translate-y-4");
            card.classList.add("opacity-100", "translate-y-0");
          }, i * 80);
        });
      });
    </script>
  </body>
</html>
